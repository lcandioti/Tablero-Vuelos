  function onSheetData(values, ts){
    if (!values || !values.length){ onSheetError("la pestaña no trae filas"); return; }
    state.rows = parseRows(values);
    setStatus("live", "Datos de la planilla · " + new Date(ts || Date.now()).toLocaleTimeString("es-AR",{hour:"2-digit",minute:"2-digit"}) + " · " + fmtInt(state.rows.length) + " vuelos");
    hideNotice();
  }

  function setProjNote(html){ var n = $("proj-note"); n.hidden = !html; n.innerHTML = html || ""; }
  function onAgenda(list){
    var now = new Date(), perDay = {}, capped = 0, skipped = [];
    (list || []).forEach(function(cal){
      if (cal.error){ skipped.push(cal.ac); return; }
      cal.events.forEach(function(ev){
        if (ev[2]) return;                       // evento de día completo
        var st = new Date(ev[0]), en = new Date(ev[1]);
        if (isNaN(st) || isNaN(en) || st < now) return;
        var h = (en - st) / 36e5; if (!(h > 0)) return;
        if (h > EVENT_CAP){ h = EVENT_CAP; capped++; }
        var day = new Date(st.getFullYear(), st.getMonth(), st.getDate());
        var key = cal.ac + "|" + day.getTime();
        var o = perDay[key] || (perDay[key] = { ac: cal.ac, date: day, hours: 0, n: 0 });
        o.hours += h; o.n++;
      });
    });
    state.proj = Object.keys(perDay).map(function(k){ return perDay[k]; });
    state.projLoading = false;
    setProjNote('Agenda leída de Google Calendar: <b>'+fmtH(sum(state.proj))+' h</b> en los próximos '+PROJ_DAYS+' días. Cada turno cuenta lo que dura, con un tope de '+EVENT_CAP+' h por evento'+
      (capped ? ' ('+capped+(capped===1?' evento recortado':' eventos recortados')+')' : '')+'.'+
      (skipped.length ? ' <span class="dot warn"></span>Sin acceso al calendario de '+esc(skipped.join(", "))+'.' : ''));
  }

  // Datos: [fecha, alumno, finalidad, instructor, origen, destino, horas, avión] por fila,
  // y la agenda por avión. Los arma el Apps Script y los sirve desde su caché.
  var API = "https://script.google.com/macros/s/AKfycbwlstfIcrjLv-gOTq7sBVe1KI7xtezzsQMR8qNfaWEHoaq18vuCKKrcNmIZL2mdl7jlLA/exec";
  var STORE = "gen-tablero-datos";
  function applyDatos(d){
    if (!d || !d.vuelos) return false;
    var rows = [[]].concat(d.vuelos.map(function(c){
      var r = []; r[1] = c[0]; r[2] = c[1]; r[3] = c[2]; r[4] = c[3]; r[5] = c[4]; r[6] = c[5]; r[9] = c[6]; r[13] = c[7]; return r;
    }));
    onSheetData(rows, d.ts);
    onAgenda(d.agenda || []);
    render();
    return true;
  }
  function fetchDatos(fresco){
    // sin cookies: no interviene ninguna sesión de Google del navegador
    return fetch(API + "?d=datos" + (fresco ? "&fresco=1" : "") + "&t=" + Date.now(), { credentials: "omit" })
      .then(function(r){ if (!r.ok) throw new Error("respuesta " + r.status); return r.json(); })
      .then(function(j){ if (!j || !j.ok) throw new Error((j && j.error) || "respuesta inválida"); return j.data; });
  }
  function loadDatos(fresco){
    return fetchDatos(fresco).then(function(d){
      applyDatos(d);
      try { localStorage.setItem(STORE, JSON.stringify(d)); } catch(e) {}
    }).catch(onSheetError);
  }

  skeleton();
  // 1) datos incrustados por el servidor, 2) los últimos guardados en este navegador, 3) pedirlos
  var inicial = window.__DATOS__ || null;
  if (!inicial){ try { inicial = JSON.parse(localStorage.getItem(STORE) || "null"); } catch(e) { inicial = null; } }
  var mostrado = applyDatos(inicial);
  if (!window.__DATOS__) loadDatos(false);
  else if (!mostrado) loadDatos(false);
  setInterval(function(){ if (!document.hidden) loadDatos(false); }, 300000);
  $("refresh").addEventListener("click", function(){
    setStatus("", "Actualizando desde la planilla…");
    loadDatos(true);
  });
})();
</script>

</body>
</html>

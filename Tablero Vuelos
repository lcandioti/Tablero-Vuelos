    var dest = rows.filter(function(r){ return r.from === BASE && r.to && r.to !== BASE; })
      .map(function(r){ return Object.assign({}, r, {dst: r.to}); });
    stackedRank(dest, "dst", 6, $("dest"), true);
  }


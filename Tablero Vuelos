  // ---------- Carga de datos (Apps Script) ----------
  function setStatus(kind, text){ $("status").innerHTML = '<span class="dot '+kind+'"></span>' + esc(text); }
  function showNotice(title, body){
    var n = $("notice"); n.hidden = false;
    n.className = "notice"; n.innerHTML = '<b>'+esc(title)+'</b><span>'+body+'</span>';
  }
  function hideNotice(){ $("notice").hidden = true; }
  function skeleton(){

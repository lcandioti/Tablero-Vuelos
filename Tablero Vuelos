    $("chart").innerHTML = '<div class="skel" style="height:260px"></div>';
  }
  function errText(err){ return esc((err && (err.message || err)) || "error desconocido"); }
  function onSheetError(err){
    if (state.rows){
      setStatus("warn", "No se pudo actualizar. Se muestran los últimos datos.");
      return;
    }
    setStatus("err", "Sin acceso a los datos");
